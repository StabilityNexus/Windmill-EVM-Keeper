# ── Keeper Strategy ──────────────────────────────────────────────────
KEEPER_STRATEGY=windmill

# ── Network Configuration ───────────────────────────────────────────
# JSON-RPC endpoint for the target chain
RPC_URL=https://sepolia.base.org
EXPECTED_CHAIN_ID=84532

# ── Transaction Execution ───────────────────────────────────────────
PRIVATE_KEY=
CONTRACT_ADDRESS=
TX_CONFIRMATIONS=1
MAX_ACTIONS_PER_CYCLE=25

# ── Scheduling and Safety ───────────────────────────────────────────
KEEPER_INTERVAL_MS=15000
DRY_RUN=false
LOG_LEVEL=info

# ── Event Scanning ──────────────────────────────────────────────────
# Block number to start scanning OrderCreated events from (optional).
# Set this to the contract deployment block for faster initial sync.
DEPLOY_BLOCK=0
# Optional read-only dashboard telemetry endpoint. Leave as 0 to disable.
TELEMETRY_PORT=0
# Bind to localhost by default. Set to 0.0.0.0 only when an external probe requires it.
TELEMETRY_HOST=127.0.0.1
TELEMETRY_ID=
